{{page-title "Delivery workspace"}}
<div class="flex flex-col items-center justify-center py-12 space-y-4">
    <h1 class="text-xl font-semibold">Delivery workspace</h1>
    {{#if (eq this.state "STARTING")}}
        <Spinner @loadingMessage="Checking App access..." @wrapperClass="flex flex-row items-center" @iconClass="mr-2" />
    {{/if}}
    {{#if (eq this.state "MFA_REQUIRED")}}
        <form class="flex flex-col space-y-4" {{on "submit" this.verify}}>
            <label for="webappstack-mfa">Authenticator or recovery code</label>
            <Input id="webappstack-mfa" @value={{this.code}} autocomplete="one-time-code" required={{true}} />
            <button type="submit" class="btn btn-primary">Verify and continue</button>
        </form>
    {{/if}}
    {{#if this.error}}
        <p role="alert" class="text-red-600">{{this.error}}</p>
        <button type="button" class="btn btn-primary" {{on "click" this.retry}}>Start a new login</button>
    {{/if}}
    <p class="text-sm text-gray-500">App access is checked on every request. Realtime delivery updates are currently unavailable.</p>
</div>
