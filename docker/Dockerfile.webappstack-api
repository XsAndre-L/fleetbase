ARG FLEETBASE_BASE_IMAGE=webappstack-fleetbase-base:dev
FROM ${FLEETBASE_BASE_IMAGE}
ARG FORK_REVISION
LABEL org.opencontainers.image.source="https://github.com/XsAndre-L/fleetbase" org.opencontainers.image.revision="${FORK_REVISION}"
ENV WEBAPPSTACK_FORK_REVISION=${FORK_REVISION}
COPY --chown=www-data:www-data api/app /fleetbase/api/app
COPY --chown=www-data:www-data api/config /fleetbase/api/config
COPY --chown=www-data:www-data api/database /fleetbase/api/database
RUN composer dump-autoload --no-dev --no-scripts --classmap-authoritative \
    && find app/Integrations/WebAppStack -name '*.php' -exec php -l {} \; \
    && php -l app/Providers/WebAppStackServiceProvider.php
ENTRYPOINT ["docker-php-entrypoint"]
CMD ["php", "artisan", "octane:frankenphp", "--max-requests=250", "--port=8000", "--host=0.0.0.0"]
