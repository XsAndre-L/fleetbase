FROM node:22.22.0-alpine3.22 AS builder
WORKDIR /console
RUN apk add --no-cache git && npm install --global pnpm@11.0.9
COPY console/package.json console/pnpm-lock.yaml console/pnpm-workspace.yaml ./
COPY console/.npmr[c] ./
RUN pnpm install --frozen-lockfile
COPY console/ ./
ENV WEBAPPSTACK_ENABLED=true DISABLE_RUNTIME_CONFIG=false
RUN pnpm exec ember build --environment=production

FROM nginx:1.28.0-alpine
ARG FORK_REVISION
LABEL org.opencontainers.image.source="https://github.com/XsAndre-L/fleetbase" org.opencontainers.image.revision="${FORK_REVISION}"
COPY --from=builder /console/dist /usr/share/nginx/html
COPY console/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 4200
CMD ["nginx", "-g", "daemon off;"]
